@@ -29,8 +29,12 @@
 
 #ifdef _PYMOL_FREETYPE
 #include "FontTTF.h"
+#ifndef __EMSCRIPTEN__
+/* The wasm build registers no Gentium face (TextInit), so it does not
+ * compile the header in. */
 #include "FontTTF2.h"
 #endif
